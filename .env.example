# System Configuration & Paths
MODEL_PATH=models/artifacts/best_model.joblib
MODEL_VERSION=1.0.0
SCALER_PATH=models/artifacts/scaler.joblib
ANOMALY_MODEL_PATH=models/artifacts/isolation_forest.joblib
FEATURE_METADATA_PATH=models/artifacts/feature_names.json

# Decision Engine Thresholds & Costs
FRAUD_THRESHOLD=0.65
REVIEW_THRESHOLD=0.30
FP_COST=25.0
FN_COST=250.0
ANOMALY_WEIGHT=0.20
SUPERVISED_WEIGHT=0.80

# Database & Persistence
DATABASE_URL=sqlite:///./fraud_detection.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Optional Streaming (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=financial_transactions
KAFKA_TOPIC_ALERTS=fraud_alerts
